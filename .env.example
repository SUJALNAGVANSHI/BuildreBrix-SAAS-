# ==============================================================================
# BuilderBrix — Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or .env.local to version control.
# Copy this file to .env.local and populate with cryptographically secure values.
# ==============================================================================

# Application Settings
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Security & Cryptographic Sessions
# Must be a cryptographically secure random string (minimum 64 characters)
# Generate with: openssl rand -base64 48
SESSION_SECRET=change_me_to_a_secure_random_64_character_string_in_production
SESSION_COOKIE_NAME=builderbrix_session
SESSION_MAX_AGE_SECONDS=86400

# Rate Limiting & DoS Protection
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_MS=60000

# DPDP Act 2023 Ephemeral Processing
# Enforces zero-disk persistence and RAM-only evaluation by default
EPHEMERAL_MODE_DEFAULT=true

# Anti-SSRF Defense & Network Safeguards
# Resolves destination hostnames and blocks private/cloud-metadata IPv4/IPv6 addresses
ANTI_SSRF_STRICT_MODE=true

# OCR Worker Execution Controls
# Maximum time (ms) allowed for Tesseract.js image optical recognition before termination
OCR_WORKER_TIMEOUT_MS=12000
MAX_IMAGE_UPLOAD_BYTES=5242880

# External Intelligence Feeds (Optional / Controlled Sandboxes)
# NOTE: External integrations are simulated sandboxes until formal regulatory
# clearance and data-sharing memoranda of understanding (MoU) are executed.
VIRUSTOTAL_API_KEY=
GOOGLE_SAFEBROWSING_API_KEY=
I4C_CYBERCRIME_API_ENDPOINT=
RBI_FRAUD_FEED_ENDPOINT=
NPCI_UPI_SAFETY_ENDPOINT=
